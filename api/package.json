{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "API de CompuStore SV (Express + Prisma + MariaDB)",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/00-main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/00-main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "circular": "madge --circular --extensions ts --ts-config tsconfig.json --exclude generated/ src",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm circular",
    "db:migrar": "prisma migrate dev",
    "db:desplegar": "prisma migrate deploy",
    "db:sembrar": "prisma db seed",
    "db:reiniciar": "prisma migrate reset --force && prisma db seed",
    "db:respaldar": "bash scripts/respaldo.sh",
    "db:restaurar": "bash scripts/restaurar.sh",
    "usuarios:vincular": "tsx --env-file=.env scripts/vincular-usuario.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "firebase-admin": "14.5.1",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "madge": "8.0.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
