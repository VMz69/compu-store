# Copiar a .env (desarrollo) y a .env.test (pruebas, BD compustore_test). Nunca subir los archivos reales.
NODE_ENV=development
PORT=3000
# mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE  (MariaDB 11.8)
DATABASE_URL=mysql://compustore:CAMBIAR@localhost:3306/compustore
# Shadow DB para `prisma migrate dev` (solo en .env de desarrollo; no hace falta en .env.test ni en producción).
SHADOW_DATABASE_URL=mysql://compustore:CAMBIAR@localhost:3306/compustore_shadow
# Orígenes permitidos por CORS, separados por coma (admin y store en Vite).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase Admin SDK (D-01): campos del JSON de la cuenta de servicio (ver README, "Firebase").
# La private key va entre comillas dobles con los \n literales, tal como la imprime `jq .private_key`.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Clave web pública de la app "compustore-admin" (la misma que VITE_FIREBASE_API_KEY).
# Solo la usa `pnpm usuarios:vincular --enviar-restablecimiento`.
FIREBASE_WEB_API_KEY=

# Cloudinary (D-17): imágenes de productos. Panel de Cloudinary → Settings → API Keys.
# El API secret nunca se sube al repositorio. Las pruebas no las necesitan (usan un proveedor falso).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
