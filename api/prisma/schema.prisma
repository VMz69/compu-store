// Esquema de CompuStore SV — modelo de la Fase A (L02, docs/fase-1/contratos-A.md §2).
// Convenciones: modelos y columnas en español (D-19), tablas en plural snake_case (@@map),
// dinero DECIMAL(12,2) (D-05), fechas en UTC y cantidades UNSIGNED (el stock nunca es negativo).

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum CondicionProducto {
  nuevo
  usado
  reacondicionado
}

/// Slug único e inmutable (D-04). El nombre es único sin distinguir acentos por la intercalación utf8mb4_unicode_ci.
model Categoria {
  id            Int        @id @default(autoincrement())
  slug          String     @unique @db.VarChar(60)
  nombre        String     @unique @db.VarChar(40)
  icono         String     @db.VarChar(60)
  descripcion   String     @db.VarChar(160)
  creadaEn      DateTime   @default(now())
  actualizadaEn DateTime   @updatedAt
  productos     Producto[]

  @@map("categorias")
}

/// Una marca inactiva se conserva en sus productos, pero no se asigna a productos nuevos.
model Marca {
  id            Int        @id @default(autoincrement())
  slug          String     @unique @db.VarChar(60)
  nombre        String     @unique @db.VarChar(40)
  sitioWeb      String?    @db.VarChar(200)
  descripcion   String     @db.VarChar(160)
  icono         String?    @db.VarChar(60)
  activa        Boolean    @default(true)
  creadaEn      DateTime   @default(now())
  actualizadaEn DateTime   @updatedAt
  productos     Producto[]

  @@map("marcas")
}

/// Precio con IVA incluido; costo sin IVA. Con controlLotes, stock = Σ lotes (D-16).
model Producto {
  id               Int                    @id @default(autoincrement())
  sku              String                 @unique @db.VarChar(32)
  slug             String                 @unique @db.VarChar(120)
  nombre           String                 @db.VarChar(120)
  categoriaId      Int
  categoria        Categoria              @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  marcaId          Int
  marca            Marca                  @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  modelo           String                 @db.VarChar(80)
  condicion        CondicionProducto      @default(nuevo)
  costo            Decimal?               @db.Decimal(12, 2)
  precio           Decimal                @db.Decimal(12, 2)
  precioAnterior   Decimal?               @db.Decimal(12, 2)
  tasaIva          Decimal                @default(13.00) @db.Decimal(5, 2)
  stock            Int                    @default(0) @db.UnsignedInt
  puntoReorden     Int                    @default(3) @db.UnsignedInt
  controlLotes     Boolean                @default(false)
  publicado        Boolean                @default(true)
  etiqueta         String?                @db.VarChar(30)
  descripcion      String                 @db.Text
  compatibilidad   String                 @db.Text
  conectividad     String                 @db.Text
  creadoEn         DateTime               @default(now())
  actualizadoEn    DateTime               @updatedAt
  imagenes         ImagenProducto[]
  especificaciones Especificacion[]
  lotes            Lote[]
  movimientos      MovimientoInventario[]
  ofertas          OfertaProducto[]

  @@index([publicado, categoriaId])
  @@map("productos")
}

/// Máx. 8 por producto (regla del service); orden 0 = portada.
/// publicId de Cloudinary (D-17); null = URL externa (seed o pegada a mano), que nunca se destruye.
model ImagenProducto {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url        String   @db.VarChar(500)
  publicId   String?  @db.VarChar(255)
  orden      Int      @db.UnsignedTinyInt

  @@unique([productoId, orden])
  @@unique([productoId, url])
  @@map("imagenes_producto")
}

/// Imagen subida a Cloudinary que aún no pertenece a ningún producto (o que falta destruir).
/// Al guardar el producto pasa a ImagenProducto; las que superan su plazo se destruyen (limpieza de huérfanas).
model ImagenPendiente {
  id       Int      @id @default(autoincrement())
  publicId String   @unique @db.VarChar(255)
  url      String   @db.VarChar(500)
  creadaEn DateTime @default(now())

  @@index([creadaEn])
  @@map("imagenes_pendientes")
}

model Especificacion {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  clave      String   @db.VarChar(60)
  valor      String   @db.VarChar(200)
  orden      Int      @db.UnsignedTinyInt

  @@unique([productoId, orden])
  @@map("especificaciones")
}

/// Consumo FEFO; los lotes sin fecha de vencimiento se consumen al final.
model Lote {
  id          Int                    @id @default(autoincrement())
  productoId  Int
  producto    Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  numero      String                 @db.VarChar(40)
  cantidad    Int                    @db.UnsignedInt
  vence       DateTime?              @db.Date
  creadoEn    DateTime               @default(now())
  movimientos MovimientoInventario[]

  @@unique([productoId, numero])
  @@map("lotes")
}

/// Todo cambio de stock queda registrado. usuarioId null = sistema (p. ej. la carga inicial del seed).
model MovimientoInventario {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  loteId     Int?
  lote       Lote?    @relation(fields: [loteId], references: [id], onDelete: SetNull)
  delta      Int
  motivo     String   @db.VarChar(200)
  usuarioId  Int?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn   DateTime @default(now())

  @@index([productoId, creadoEn])
  @@map("movimientos_inventario")
}

/// Sin contraseña: la identidad la da Firebase (D-01). El rol es la plantilla de accesos (L09).
/// Los accesos propios del usuario viven en `usuarios_permisos`; el superadmin no los necesita (acceso total).
model Usuario {
  id                    Int                    @id @default(autoincrement())
  firebaseUid           String                 @unique @db.VarChar(128)
  correo                String                 @unique @db.VarChar(254)
  nombre                String                 @db.VarChar(80)
  telefono              String?                @db.VarChar(20)
  rol                   String                 @db.VarChar(30)
  plantilla             Rol                    @relation(fields: [rol], references: [id], onDelete: Restrict)
  activo                Boolean                @default(true)
  debeCambiarContrasena Boolean                @default(false)
  creadoEn              DateTime               @default(now())
  ultimoAcceso          DateTime?
  movimientos           MovimientoInventario[]
  permisos              UsuarioPermiso[]

  @@index([rol])
  @@map("usuarios")
}

enum TipoPermiso {
  vista
  accion
}

/// Plantilla de accesos (RoleId del admin). El catálogo lo inserta la migración `rbac`.
model Rol {
  id       String       @id @db.VarChar(30)
  nombre   String       @db.VarChar(60)
  orden    Int          @db.UnsignedSmallInt
  permisos RolPermiso[]
  usuarios Usuario[]

  @@map("roles")
}

/// Vista del menú (clave = id de la vista) o acción dentro de una vista (clave = "vista.accion").
model Permiso {
  clave    String           @id @db.VarChar(40)
  tipo     TipoPermiso
  vista    String           @db.VarChar(20)
  orden    Int              @db.UnsignedSmallInt
  roles    RolPermiso[]
  usuarios UsuarioPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId        String  @db.VarChar(30)
  rol          Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permisoClave String  @db.VarChar(40)
  permiso      Permiso @relation(fields: [permisoClave], references: [clave], onDelete: Cascade)

  @@id([rolId, permisoClave])
  @@map("roles_permisos")
}

model UsuarioPermiso {
  usuarioId    Int
  usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permisoClave String  @db.VarChar(40)
  permiso      Permiso @relation(fields: [permisoClave], references: [clave], onDelete: Restrict)

  @@id([usuarioId, permisoClave])
  @@map("usuarios_permisos")
}

/// Fila única (id = 1) con la identidad pública de la tienda; se edita desde el admin en L10.
model ConfiguracionTienda {
  id                  Int      @id @default(1)
  nombre              String   @db.VarChar(80)
  eslogan             String   @db.VarChar(120)
  ciudad              String   @db.VarChar(80)
  pais                String   @db.VarChar(60)
  direccion           String   @db.VarChar(255)
  direccionCorta      String   @db.VarChar(120)
  /// string[]
  telefonos           Json
  whatsapp            String   @db.VarChar(20)
  correo              String   @db.VarChar(254)
  horario             String   @db.VarChar(120)
  horarioCorto        String   @db.VarChar(60)
  acercaDe            String   @db.Text
  mision              String   @db.Text
  vision              String   @db.Text
  /// string[]
  valores             Json
  /// Record<string, string> (red → URL)
  redes               Json
  monedaCodigo        String   @db.Char(3)
  monedaSimbolo       String   @db.VarChar(5)
  monedaLocale        String   @db.VarChar(10)
  // Emisor (L10): datos del contribuyente que se imprimen en facturas y cotizaciones; no son públicos.
  razonSocial         String   @db.VarChar(100)
  nit                 String   @db.VarChar(17)
  nrc                 String   @db.VarChar(9)
  actividadEconomica  String   @db.VarChar(120)
  tipoEstablecimiento String   @db.VarChar(30)
  /// Próximo número de factura (solo adelanta la secuencia; la regla completa llega en L15). null = continuar.
  semillaFactura      Int?     @db.UnsignedInt
  actualizadaEn       DateTime @updatedAt

  @@map("configuracion_tienda")
}

enum TipoCliente {
  persona
  empresa
}

/// Directorio de clientes (L11). El teléfono es único por sus dígitos (`telefonoNormalizado`).
/// Documento = DUI (persona) o NIT (empresa), opcional y único. La relación con pedidos llega en L13.
model Cliente {
  id                  Int         @id @default(autoincrement())
  tipo                TipoCliente
  nombre              String      @db.VarChar(100)
  documento           String?     @unique @db.VarChar(17)
  telefono            String      @db.VarChar(20)
  telefonoNormalizado String      @unique @db.VarChar(15)
  correo              String?     @db.VarChar(254)
  ciudad              String      @db.VarChar(80)
  direccion           String      @db.VarChar(255)
  notas               String      @db.Text
  activo              Boolean     @default(true)
  creadoEn            DateTime    @default(now())
  actualizadoEn       DateTime    @updatedAt

  @@index([nombre])
  @@map("clientes")
}

enum TipoDescuento {
  porcentaje
  monto
}

/// Oferta (L12): regla de precio con vigencia sobre productos concretos. No modifica Producto.precio:
/// el precio efectivo se calcula al leer (10-ofertas/05-precio-efectivo). Fechas de calendario
/// inclusive, evaluadas con el «hoy» de El Salvador. `valor` = % (≤ 90) o monto en $ con IVA.
model Oferta {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(80)
  etiqueta      String           @db.VarChar(40)
  descripcion   String           @db.Text
  tipoDescuento TipoDescuento
  valor         Decimal          @db.Decimal(12, 2)
  inicio        DateTime         @db.Date
  fin           DateTime         @db.Date
  pausada       Boolean          @default(false)
  creadaEn      DateTime         @default(now())
  actualizadaEn DateTime         @updatedAt
  productos     OfertaProducto[]

  @@index([inicio, fin])
  @@map("ofertas")
}

model OfertaProducto {
  ofertaId   Int
  oferta     Oferta   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([ofertaId, productoId])
  @@index([productoId])
  @@map("ofertas_productos")
}
