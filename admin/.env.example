# Copiar a admin/.env (no se sube a git). Cambiar cualquier variable requiere reiniciar `pnpm dev` o volver a ejecutar `pnpm build`.

# Trazabilidad UI (mismo contrato que /store): "false" retira los atributos data-ui-* del DOM.
VITE_UI_TRACEABILITY=true
# URL del Front Office (/store) para los accesos directos "Tienda Web".
VITE_STORE_URL=http://localhost:5173
# Ruta donde se publicará el build. "/" = raíz del dominio.
VITE_BASE_PATH=/
# Panel de cuentas de prueba en el login. Con la sesión real (L03) debe quedar en "false".
VITE_SHOW_DEMO_CREDENTIALS=false

# API de CompuStore, incluido el prefijo /api/v1.
VITE_API_URL=http://localhost:3000/api/v1

# Firebase Auth (L03): Consola de Firebase › Configuración del proyecto › General › Tus apps ›
# "compustore-admin" › Configuración del SDK (objeto firebaseConfig). Son valores públicos, no secretos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
