# Apache (hosting compartido / cPanel). Funciona en la raíz o en una subcarpeta.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Archivos y carpetas reales se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Cualquier otra ruta (/productos, /ajustes/canales…) carga la SPA.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html sin caché para que cada despliegue cargue los assets nuevos.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
